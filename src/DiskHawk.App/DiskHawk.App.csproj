<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <AssemblyName>DiskHawk</AssemblyName>
    <AssemblyTitle>DiskHawk - Fleet Disk Analytics</AssemblyTitle>
    <RootNamespace>DiskHawk.App</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>..\..\assets\diskhawk.ico</ApplicationIcon>
  </PropertyGroup>
  <ItemGroup>
    <Reference Include="System.Windows.Forms" />
    <Reference Include="System.Drawing" />
    <Reference Include="System.Management" />
    <Reference Include="System.DirectoryServices" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\DiskHawk.Core\DiskHawk.Core.csproj" />
    <!-- build the scanner exe into the same output folder (this is the file copied to remote machines) -->
    <ProjectReference Include="..\DiskHawk.Scanner\DiskHawk.Scanner.csproj" ReferenceOutputAssembly="false" />
  </ItemGroup>
  <ItemGroup>
    <!-- forms are built in code; open the code view instead of the VS designer -->
    <Compile Update="*.cs" SubType="Code" />
  </ItemGroup>
  <!--
    Security: the scanner (DiskHawk.Scanner.exe) is deployed to every machine with an administrator account.
    Its SHA-256 is embedded into the console at build time (BuildInfo.ScannerSha256); before deploying, the console
    verifies that the exe on disk matches this hash. The ProjectReference makes sure the scanner is built first.
  -->
  <Target Name="EmbedScannerHash" BeforeTargets="CoreCompile" DependsOnTargets="ResolveProjectReferences">
    <PropertyGroup>
      <_DhScannerExe>$(OutDir)DiskHawk.Scanner.exe</_DhScannerExe>
      <_DhHashFile>$(IntermediateOutputPath)BuildInfo.g.cs</_DhHashFile>
      <_DhScannerSha256></_DhScannerSha256>
    </PropertyGroup>
    <Error Condition="!Exists('$(_DhScannerExe)') And '$(DesignTimeBuild)' != 'true'"
           Text="DiskHawk.Scanner.exe not found ($(_DhScannerExe)). Build the whole solution (DiskHawk.sln)." />
    <GetFileHash Condition="Exists('$(_DhScannerExe)')" Files="$(_DhScannerExe)" Algorithm="SHA256" HashEncoding="hex">
      <Output TaskParameter="Hash" PropertyName="_DhScannerSha256" />
    </GetFileHash>
    <WriteLinesToFile File="$(_DhHashFile)" Overwrite="true" WriteOnlyWhenDifferent="true"
                      Lines="// Generated by DiskHawk.App.csproj (EmbedScannerHash). Do not edit.;namespace DiskHawk.App { internal static class BuildInfo { public const string ScannerSha256 = &quot;$(_DhScannerSha256)&quot;%3B } }" />
    <ItemGroup>
      <Compile Include="$(_DhHashFile)" />
      <FileWrites Include="$(_DhHashFile)" />
    </ItemGroup>
  </Target>
</Project>
